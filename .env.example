# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (or your custom domain once connected).
APP_URL="MY_APP_URL"

# LEAD EMAIL & DOMAIN INTEGRATION (Configure when connecting your custom domain)
# Correo principal de tu dominio donde llegarán los leads
LEAD_RECIPIENT_EMAIL="admin@starlightsolutionsnv.com"

# Correo remitente verificado en tu dominio
LEAD_FROM_EMAIL="Starlight Solutions <admin@starlightsolutionsnv.com>"

# Opcional: API Key de Resend (https://resend.com) para enviar correos directos a tu dominio
RESEND_API_KEY=""

# Opcional: URL Webhook externo (Formspree, Make, Zapier, n8n, GoHighLevel, etc.)
LEAD_WEBHOOK_URL=""
